@using LogicaNegocio;
@{
    ViewData["Title"] = "Tareas";
}

<h1>Tareas</h1>

@if (ViewBag.Tareas != null && ViewBag.Tareas.Count > 0)
{
    <table border="1">
        <thead>
        <th>Id</th>
        <th>Descripcion</th>
        <th>Fecha inicio</th>
        <th>Fecha cierre</th>
        <th>Estado</th>
        <th>Comentario</th>
        </thead>
        <tbody>
            @foreach (Tarea tarea in ViewBag.Tareas)
            {
                <tr>
                    <td>@tarea.Id</td>
                    <td>@tarea.Descripcion</td>
                    <td>@tarea.FechaInicio</td>
                    <td>@tarea.FechaCierre</td>
                    <td>@tarea.TareaCompletada</td>
                    <td>@tarea.Comentario</td>
                </tr>
            }

        </tbody>
    </table>
}
else
{
    <span>No se encontraron  tareas </span>
}
@TempData["Mensaje"]