@using LogicaNegocio;
@{
    ViewData["Title"] = "TareasCompletadas";
}

<h1>TareasCompletadas</h1>

@if(ViewBag.Tareas!=null && ViewBag.Tareas.Count>0){
    <table>
        <thead>
        <th>Tareas</th>
        </thead>
        <tbody>
            @foreach (Peon peon in ViewBag.Tareas )
            {
            <td>@peon.ObtenerTareasCompletadas()</td>
            }

    </tbody>
    </table>
}
