@using LogicaNegocio;
@{
    ViewData["Title"] = "TareasCompletadas";
}

<h1>TareasCompletadas</h1>

@if(ViewBag.Empleados!=null && ViewBag.Empleados.Count>0){
    <table>
        <thead>
        <th>Tareas</th>
        </thead>
        <tbody>
            @foreach (Tarea tarea in ViewBag.Empleados.ObtenerTareasCompletadas())
            {
            <td>@tarea.Descripcion</td>

            }

    </tbody>
    </table>
}
