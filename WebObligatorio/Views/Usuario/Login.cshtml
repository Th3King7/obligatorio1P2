
@using LogicaNegocio;
@{
    ViewData["Title"] = "Login";
}

<h1>IniciarSesion</h1>

<form method="post" action="~/Usuario/IniciarSesion">
    <label>Email</label>
    <input type="text" name="Email" />
    <br />
    <label>Contraseña</label>
    <input type="password" name="Password" />
    <br />
    <input type="submit" value="IniciarSesion" />
    <br />
    <a href="~/Peon/RegistrarPeon">Registrarse</a>
</form>

